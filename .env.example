# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bulk-data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Constructed DSN (Optional override)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/docdb

# AWS Secrets Manager (optional). With USE_SECRET_MANAGER=true, host, user and
# password come from the secret DB_SECRET_NAME (port too, if it has one);
# POSTGRES_DB still names the database. POSTGRES_HOST/USER/PASSWORD and
# DATABASE_URL are then ignored.
# AWS access: on EC2 leave the two keys below unset so the instance role is
# used. Set them only when running off EC2; keys in .env take precedence over
# the instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
USE_SECRET_MANAGER=false
# DB_SECRET_NAME=prod/docdb-ingestion/postgres
# AWS_REGION=eu-central-1

# EPO front-file runner
EPO_FRONTFILE_PRODUCT_ID=3
BACKFILE_TIME=2026-02-24T10:50:03.000+01:00

# Run report email (shared configuration with the DRM scripts)
EMAIL_RECIPIENT=ops@example.com
EMAIL_CONFIG_HOST=smtp.example.com
EMAIL_CONFIG_PORT=587
EMAIL_CONFIG_AUTH_USER=noreply@example.com
EMAIL_CONFIG_AUTH_PASSWORD=changeme
